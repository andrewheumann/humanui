<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HumanUI</RootNamespace>
    <AssemblyName>HumanUI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1701;CS0168;CS0219</NoWarn>
    <FallbackCulture>en-US</FallbackCulture>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="HelixToolkit.Wpf" Version="2.27.0" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="De.TorstenMandelkow.MetroChart">
      <HintPath>..\..\lib\De.TorstenMandelkow.MetroChart.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Markdown.Xaml">
      <HintPath>..\..\lib\Markdown.Xaml.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HumanUIBaseApp\HumanUIBaseApp\HumanUIBaseApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Components\UI Elements\Create_TEMPLATE_Component.cs" />
    <Compile Remove="Components\UI Output\Set_TEMPLATE_Component.cs" />
    <None Include="Components\UI Elements\Create_TEMPLATE_Component.cs" />
    <None Include="Components\UI Output\Set_TEMPLATE_Component.cs" />
    <!-- Hidden deprecated components that relied on removed MahApps 1.x APIs. Excluded from net8 build. -->
    <Compile Remove="Deprecated\SetWindowProperties_Component_DEPRECATED.cs" />
    <Compile Remove="Deprecated\SetWindowProperties_Component_ALSO_DEPRECATED.cs" />
    <Compile Remove="Deprecated\TabContainer_Component_ALSO_DEPRECATED.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Styles.Default.xaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Emit a .gha alongside the .dll for Grasshopper packaging. Keeping the primary output as
       .dll lets the test project consume HumanUI normally; CoreCLR rejects non-.dll entries in
       its Trusted Platform Assemblies list. -->
  <Target Name="CopyGhaFromDll" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(AssemblyName).gha" />
  </Target>

</Project>
